#include <stdio.h>
#include <stdlib.h>
#include <omp.h>
#include <math.h>

#include "exclusive_scan.h"
//This function implements the exlusive 
void exclusive_scan(int A[], int n) {

	if (n==1) {
		A[0] = 0;
		return;
	} 
	if(n==2) {
		A[1] = A[0];
		A[0] = 0;
		return;
	} 
	int h1;
	int h2;
	h1 = A[0];
	h2 = A[1];
	A[1] = h1;
	A[0] = 0;
	
	int i;

	for(i=2; i<n; i++) {
		h1 = A[i];
		A[i] = h2 + A[i-1];
		h2 = h1;
	}
	return;
}